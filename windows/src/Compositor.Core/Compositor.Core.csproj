<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Jint" Version="4.16.4" />
    <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="14.17.2" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.152.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../fonts/NotoSansSC.ttf" Link="fonts/NotoSansSC.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../models/u2netp.onnx" Link="models/u2netp.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../lensfun/*.xml" Link="lensfun/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/CameraRawShadows.bin" LogicalName="Compositor.CameraRawShadows.bin" />
    <EmbeddedResource Include="Resources/CameraRawTables.deflate" LogicalName="Compositor.CameraRawTables.bin" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compositor.Core.Tests" />
  </ItemGroup>

  <Target Name="PrepareColorRuntime" BeforeTargets="AssignTargetPaths" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/ensure-color-runtime.ps1&quot;" />
    <ItemGroup>
      <_ColorRuntimeFile Include="../../runtime/color/**/*" />
      <Content Include="@(_ColorRuntimeFile)" Link="color-runtime/%(_ColorRuntimeFile.RecursiveDir)%(_ColorRuntimeFile.Filename)%(_ColorRuntimeFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="Resources/ocio_worker.py" Link="ocio_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
